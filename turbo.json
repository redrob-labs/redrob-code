{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "REDROB_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "REDROB_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "redrob#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@redrob-code/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@redrob-code/function#test": {
      "outputs": []
    }
  }
}
