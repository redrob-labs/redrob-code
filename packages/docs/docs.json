{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "@redrob-code/docs",
  "colors": {
    "primary": "#2b52ff",
    "light": "#507fff",
    "dark": "#1733d5"
  },
  "fonts": {
    "heading": {
      "family": "Pretendard Variable",
      "source": "https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/woff2/PretendardVariable.woff2",
      "format": "woff2",
      "weight": 700
    },
    "body": {
      "family": "Pretendard Variable",
      "source": "https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/woff2/PretendardVariable.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "development"],
            "openapi": "https://code.redrob.ai/openapi.json"
          }
        ]
      }
    ],
    "global": {}
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://github.com/redrob-labs/redrob-code/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://console.redrob.ai"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/redrob-labs/redrob-code"
    }
  }
}
